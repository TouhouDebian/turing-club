---
import { Icon } from "astro-icon/components";
import darkCss from "../../public/giscus/turing-dark.css?raw";
import lightCss from "../../public/giscus/turing-light.css?raw";

const giscusConfig = {
	repo: "TouhouDebian/turing-club",
	repoId: "R_kgDOTIIqkA",
	category: "General",
	categoryId: "DIC_kwDOTIIqkM4DALmQ",
};

const giscusThemes = { light: lightCss, dark: darkCss };
---

<section class="card-base giscus-comments onload-animation">
	<div class="giscus-heading">
		<Icon name="material-symbols:forum-outline-rounded" class="text-[1.4rem]" />
		<h2>
			<span class="lang-zh">评论</span>
			<span class="lang-en">Comments</span>
		</h2>
	</div>
	<p class="giscus-note lang-zh">评论由 GitHub Discussions 提供，发布时需登录 GitHub。</p>
	<p class="giscus-note lang-en">Comments use GitHub Discussions. Sign in to GitHub to post.</p>
	<div class="giscus-shell"></div>
</section>

<script is:inline define:vars={{ giscusConfig, giscusThemes }}>
	(() => {
		window.disposeGiscusTheme?.();
		const shell = document.currentScript.previousElementSibling.querySelector(".giscus-shell");
		if (!shell) return;
		const giscusOrigin = "https://giscus.app";
		const client = document.createElement("script");
		const frameThemes = new WeakMap();
		const frameListeners = new Map();

		const encodeCss = (css) => {
			const bytes = new TextEncoder().encode(css);
			let binary = "";
			for (const byte of bytes) binary += String.fromCharCode(byte);
			return window.btoa(binary);
		};

		// Embed the CSS so neither a slow fetch nor an old response can change the theme.
		const getThemeValue = () => {
			const css = document.documentElement.classList.contains("dark")
				? giscusThemes.dark
				: giscusThemes.light;
			const hue = Number.parseInt(
				getComputedStyle(document.documentElement).getPropertyValue("--hue").trim(),
				10,
			) || 250;
			return `data:text/css;base64,${encodeCss(`main { --giscus-hue: ${hue}; }\n${css}`)}`;
		};

		const syncGiscusTheme = () => {
			if (!shell.isConnected) return;
			const theme = getThemeValue();
			// Keep the iframe URL short; custom CSS is delivered through postMessage.
			client.dataset.theme = document.documentElement.classList.contains("dark") ? "dark" : "light";
			for (const frame of shell.querySelectorAll("iframe.giscus-frame")) {
				if (!frameListeners.has(frame)) {
					const onLoad = () => {
						frameThemes.delete(frame);
						syncGiscusTheme();
					};
					frame.addEventListener("load", onLoad);
					frameListeners.set(frame, onLoad);
				}
				if (!frame.contentWindow || frameThemes.get(frame) === theme) continue;
				frame.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, giscusOrigin);
				frameThemes.set(frame, theme);
			}
		};

		const onMessage = (event) => {
			if (event.origin !== giscusOrigin || !event.data?.giscus) return;
			const frame = [...frameListeners.keys()].find((item) => item.contentWindow === event.source);
			if (!frame) return;
			syncGiscusTheme();
		};
		window.addEventListener("message", onMessage);
		const themeObserver = new MutationObserver(syncGiscusTheme);
		themeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class", "style"],
		});
		const frameObserver = new MutationObserver(syncGiscusTheme);
		frameObserver.observe(shell, { childList: true, subtree: true });
		window.disposeGiscusTheme = () => {
			themeObserver.disconnect();
			frameObserver.disconnect();
			window.removeEventListener("message", onMessage);
			for (const [frame, listener] of frameListeners) frame.removeEventListener("load", listener);
			frameListeners.clear();
		};

		Object.assign(client.dataset, giscusConfig, {
			mapping: "pathname",
			strict: "0",
			reactionsEnabled: "1",
			emitMetadata: "0",
			inputPosition: "top",
			lang: "zh-CN",
			loading: "lazy",
		});
		client.src = `${giscusOrigin}/client.js`;
		client.crossOrigin = "anonymous";
		client.async = true;
		syncGiscusTheme();
		shell.appendChild(client);
	})();
</script>

<style>
	.giscus-comments {
		margin-bottom: 1rem;
		padding: 1.5rem;
	}

	.giscus-heading {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--primary);
	}

	.giscus-heading h2 {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 800;
	}

	.giscus-note {
		margin: 0.45rem 0 1.15rem;
		color: rgba(0, 0, 0, 0.55);
		font-size: 0.9rem;
		font-weight: 600;
	}

	:global(.dark) .giscus-note {
		color: rgba(255, 255, 255, 0.58);
	}

	.giscus-shell {
		min-height: 18rem;
	}
</style>
